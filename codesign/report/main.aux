\newlabel{eq:z}{{1}{2}{}{equation.1}{}}
\newlabel{fig:design}{{1}{2}{Implementation. The client layer computes each task's index once and attaches it as the priority of every model call the task makes; a scheduler plug-in loaded with \texttt {--scheduler-cls} applies it inside vLLM. Shaded boxes are ours}{figure.1}{}}
\newlabel{tab:main}{{1}{2}{All tasks at 16k tokens of KV memory, seven seeds (653 paired tasks). ``Faster'': share of tasks that finish earlier than under vLLM}{table.1}{}}
\newlabel{sec:eval}{{3}{2}{}{section.3}{}}
\citation{shahout2024lamps}
\newlabel{fig:headline}{{2}{3}{Task completion times at 16k tokens of KV memory, seven workloads. (a) Fan-out tasks and ReAct tasks with up to four turns (539 of 653 tasks): our index finishes 90\% of them within 45\,s versus 74\,s with vLLM, and the slowest within 71\,s versus 120\,s. The longest tasks (six-turn ReAct, 17\%) are discussed in Section~\ref {sec:plan}. (b) Median over all tasks, per workload: our index improves every seed, by 29--46\% (mean: 11--24\%)}{figure.2}{}}
\newlabel{fig:memory}{{3}{3}{Latency reduction of our index over vLLM as KV memory grows (95\% CIs). The tighter the memory, the larger the gain; with ample memory scheduling order barely matters and the index costs nothing}{figure.3}{}}
\newlabel{sec:plan}{{4}{3}{}{section.4}{}}
